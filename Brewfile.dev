# frozen_string_literal: true

# vim: ft=ruby
#
# What a contributor to openlanes needs on top of the runtime `Brewfile`.
# `bin/setup` bundles both; the gem ships only `Brewfile`, so nobody who
# installs openlanes gets these.

# sopsy lives in a tap, not homebrew-core
tap 'kigster/tap'

# New very fast ruby installer
brew 'rv'
brew 'rbenv'

# See https://sopsy-cli.dev/
brew 'sops'
brew 'age'
brew 'age-plugin-se'
brew 'sopsy'

# Pre-commit hooks to check for secrets
brew 'gitleaks'
brew 'detect-secrets'

# Multi-processor Manager (similar to foreman in ruby)
brew 'mprocs'

# Diagrams and CI
brew 'mermaid-cli'
brew 'circleci'
