#!/usr/bin/env ruby
# frozen_string_literal: true

# openlanes — spec → plan → build.
#
# Every command does the work it is named for; -n / --dry-run previews it.
#
# © 2026 Konstantin Gredeskoul

# Resolve the dependencies from this repository without the bundler, thank you very much.
module OpenLanes
  PROJECT_ROOT = File.expand_path("..", __dir__)
end

if OpenLanes::PROJECT_ROOT.include?("lib/ruby/gems")
  require "rubygems"
  gem "openlanes"
end

# lib/ goes first on the load path: several files `require "openlanes/..."`,
# and without this those resolve to whichever openlanes gem is installed,
# not to this checkout, and one class ends up defined twice.
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require_relative "../lib/openlanes"
require_relative "../lib/openlanes/launcher"

begin
  OpenLanes::Launcher.new(ARGV.dup).execute!
rescue SystemExit => e
  exit(e.status)
end
