#!/usr/bin/env bash
#
# bin/wiki-publish — regenerate the OpenLanes wiki and push it to the GitHub Wiki repo.
#
# The GitHub Wiki is a SEPARATE git repository (kigster/openlanes.wiki.git) that
# GitHub does not create until at least one page has been created through the
# web UI. If the clone below 404s, that is why, and this script says so rather
# than failing mute.
#
# Usage:
#   bin/wiki-publish              # regenerate, sync, commit, push
#   bin/wiki-publish --dry-run    # everything except the push
#
set -euo pipefail

REPO_SLUG="kigster/openlanes"
WIKI_SSH="git@github.com:${REPO_SLUG}.wiki.git"
WIKI_HTTPS="https://github.com/${REPO_SLUG}.wiki.git"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

STAGE="$(mktemp -d -t openlanes-wiki-stage)"
CLONE="$(mktemp -d -t openlanes-wiki-clone)"
trap 'rm -rf "$STAGE" "$CLONE"' EXIT

echo "==> Generating wiki pages (extension-less links for GitHub Wiki)"
"$ROOT/bin/wiki-gen" --out "$STAGE" --link-style wiki

echo "==> Cloning $REPO_SLUG.wiki"
rm -rf "$CLONE"
if ! GIT_TERMINAL_PROMPT=0 git clone --quiet "$WIKI_SSH" "$CLONE" 2>/dev/null; then
  echo "    SSH clone failed; retrying over HTTPS with the gh credential helper"
  if ! GIT_TERMINAL_PROMPT=0 git -c credential.helper= \
        -c credential.helper='!gh auth git-credential' \
        clone --quiet "$WIKI_HTTPS" "$CLONE" 2>/dev/null; then
    cat >&2 <<EOF

The wiki repository does not exist yet.

GitHub does not create <${REPO_SLUG}.wiki.git> until the wiki has at
least one page, and a page cannot be created through the API — only through the
web UI. One-time fix, about thirty seconds:

  1. Open  https://github.com/${REPO_SLUG}/wiki
  2. Click "Create the first page"
  3. Title it exactly:  Home
  4. Put anything in the body (this script overwrites it)
  5. Click "Save Page"

Then re-run:  bin/wiki-publish

Nothing was published. Preview the pages locally with: bin/wiki-gen --out /tmp/wiki
EOF
    exit 2
  fi
fi

echo "==> Syncing pages"
# Remove previously generated pages so a deleted page disappears from the wiki,
# but leave anything a human authored directly in the wiki UI alone.
while IFS= read -r -d '' f; do
  if head -n 1 "$f" | grep -q 'generated-by: bin/wiki-gen'; then rm -f "$f"; fi
done < <(find "$CLONE" -maxdepth 1 -name '*.md' -print0)

cp "$STAGE"/*.md "$CLONE"/
# The in-repo folder README is about the folder, not about the wiki.
rm -f "$CLONE/README.md"

cd "$CLONE"
if git diff --quiet && git diff --cached --quiet && [[ -z "$(git status --porcelain)" ]]; then
  echo "==> Wiki is already up to date; nothing to push."
  exit 0
fi

git add -A
git -c user.name="wiki-gen" -c user.email="wiki-gen@users.noreply.github.com" \
    commit  --no-gpg-sign --quiet -m "Regenerate wiki from repository documentation

Generated by bin/wiki-gen from the state of main. Do not edit wiki
pages by hand -- edit the source each page names and re-run the
generator."

if [[ "$DRY_RUN" == "1" ]]; then
  echo "==> --dry-run: not pushing. Staged commit:"
  git --no-pager show --stat --oneline HEAD | head -50
  exit 0
fi

echo "==> Pushing"
git push --quiet origin HEAD
echo "==> Published: https://github.com/${REPO_SLUG}/wiki"
