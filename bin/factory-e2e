#!/usr/bin/env bash
# vim: ft=bash
#
# The factory integration test: a throwaway git repository, `openlanes start`
# serving it, and Cypress building a tic-tac-toe page through the control
# room with real agents. It spends real tokens, so it refuses to run unless
# OPENLANES_FACTORY_E2E=1 says so, and nothing in `just test`, `just web-e2e`
# or CircleCI calls it.
#
#   OPENLANES_FACTORY_E2E=1 just factory-e2e
#
# Settings, each with a default:
#
#   FACTORY_PORT       control room port                    (4777)
#   FACTORY_REDIS_URL  Redis for the board and its commands (redis://localhost:6379/11)
#   FACTORY_MODEL      model every agent runs on            (haiku)
#   FACTORY_TIMEOUT    seconds before one agent is abandoned (600)
#   FACTORY_MINUTES    minutes Cypress waits for the build  (15)
#
# What it leaves behind is log/factory-e2e/: the progress log, the last
# board, every plan's state.json and spec.md, the built index.html, and the
# tail of each agent's trace. The temp repository and the `openlanes start` it
# launched are always torn down, pass or fail; nothing it did not start is
# touched.

set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${OPENLANES_FACTORY_E2E:-}" != "1" ]]; then
  echo "factory-e2e runs real agents and spends real tokens." >&2
  echo "Set OPENLANES_FACTORY_E2E=1 to run it: OPENLANES_FACTORY_E2E=1 just factory-e2e" >&2
  exit 64
fi

port="${FACTORY_PORT:-4777}"
redis_url="${FACTORY_REDIS_URL:-redis://localhost:6379/11}"
model="${FACTORY_MODEL:-haiku}"
timeout="${FACTORY_TIMEOUT:-600}"
minutes="${FACTORY_MINUTES:-15}"
artifacts="${repo}/log/factory-e2e"

command -v claude >/dev/null || { echo "claude is not on PATH; the factory has no agents to run." >&2; exit 69; }
if command -v redis-cli >/dev/null && ! redis-cli -u "${redis_url}" ping >/dev/null 2>&1; then
  echo "Redis does not answer on ${redis_url}." >&2
  exit 69
fi
# Another server on the port (the user's own `openlanes web` on 11000, say) is
# left alone: the run refuses rather than share or kill it.
if lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port ${port} is taken; set FACTORY_PORT to a free one." >&2
  exit 69
fi
[[ -f "${repo}/web/dist/index.html" ]] || { echo "web/dist is missing; run just web-build first." >&2; exit 66; }

tmp="$(mktemp -d "${TMPDIR:-/tmp}/openlanes-factory.XXXXXX")"
project="${tmp}/tictactoe"
started_at="${tmp}/.started"
pid=""

openlanes() { "${repo}/exe/openlanes" "$@"; }

collect() {
  rm -rf "${artifacts}"
  mkdir -p "${artifacts}/plans" "${artifacts}/traces"
  curl -sf "http://127.0.0.1:${port}/api/board" -o "${artifacts}/board.json" 2>/dev/null || true
  cp "${tmp}/progress.log" "${artifacts}/" 2>/dev/null || true
  cp "${tmp}/start.log" "${artifacts}/" 2>/dev/null || true
  if [[ -d "${project}/.plans" ]]; then
    for plan in "${project}"/.plans/*/; do
      name="$(basename "${plan}")"
      mkdir -p "${artifacts}/plans/${name}"
      cp "${plan}"*.md "${plan}"state.json "${artifacts}/plans/${name}/" 2>/dev/null || true
    done
  fi
  find "${project}" -name index.html -not -path '*/.git/*' -not -path '*/node_modules/*' \
    -exec cp {} "${artifacts}/" \; 2>/dev/null || true
  (cd "${project}" 2>/dev/null && git status --short >"${artifacts}/git-status.txt") || true
  # The traces live outside every repository (Executor::TRACE_DIR); keep the
  # tail of the ones this run wrote.
  traces="${TMPDIR:-/tmp}"
  traces="${traces%/}/openlanes-traces"
  if [[ -d "${traces}" ]]; then
    find "${traces}" -type f -newer "${started_at}" | while read -r trace; do
      tail -n 40 "${trace}" >"${artifacts}/traces/$(basename "${trace}")"
    done
  fi
}

teardown() {
  status=$?
  trap - EXIT INT TERM
  collect || true
  if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
    # TERM is `openlanes start`'s graceful stop: its agents are told to stop and
    # its control room goes down with it. KILL only if it outlives that.
    kill -TERM "${pid}" 2>/dev/null || true
    for _ in $(seq 1 30); do kill -0 "${pid}" 2>/dev/null || break; sleep 1; done
    kill -KILL "${pid}" 2>/dev/null || true
  fi
  rm -rf "${tmp}"
  echo "factory-e2e: artifacts in ${artifacts}" >&2
  exit "${status}"
}
trap teardown EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

touch "${started_at}"

# A repository with one commit and `openlanes init`, and no remote: nothing this
# run does can reach GitHub.
mkdir -p "${project}"
(
  cd "${project}"
  git init -q -b main
  git config user.name "Factory Test"
  git config user.email "factory-test@example.invalid"
  cat >README.md <<'MARKDOWN'
# Tic Tac Toe

A static web page: plain HTML, CSS and JavaScript in the repository root,
opened straight from disk. There is no package manager, no build step and no
test runner; check a change by reading it and opening the page.
MARKDOWN
  git add README.md
  git commit -q -m "Initial commit"
  openlanes init -y -q --project "Tic Tac Toe" -j 1
  git add -A
  git commit -q -m "Initialize openlanes"
)

# `--isolation shared` is the existing local-only mode: one tree, no branch
# per plan, and no publisher, so nothing is pushed and no pull request is
# opened. The finished build stays at 🟡 Building, done for this run: 🟢
# Ready for Review needs an open pull request.
(
  cd "${project}"
  exec "${repo}/exe/openlanes" start --no-open \
    --port "${port}" --redis-url "${redis_url}" \
    --isolation shared -j 1 \
    --model "${model}" --timeout "${timeout}" \
    --log "${tmp}/progress.log"
) >"${tmp}/start.log" 2>&1 &
pid=$!

for _ in $(seq 1 120); do
  curl -sf "http://127.0.0.1:${port}/healthz" >/dev/null 2>&1 && break
  kill -0 "${pid}" 2>/dev/null || { echo "openlanes start exited:" >&2; cat "${tmp}/start.log" >&2; exit 1; }
  sleep 0.5
done
curl -sf "http://127.0.0.1:${port}/healthz" >/dev/null || { echo "The control room never answered on ${port}." >&2; exit 1; }

cd "${repo}/web"
npx cypress run --config-file cypress.factory.config.ts \
  --config "baseUrl=http://127.0.0.1:${port}" \
  --env "projectDir=${project},minutes=${minutes}"
