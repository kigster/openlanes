pipeline {
  agent { docker { image '<%= image %>' } }
  stages {
<% if just -%>
    stage('Install just') {
      steps { sh '<%= just_install.sub("/usr/local/bin", ".bin") %>' }
    }
<% end -%>
<% if install -%>
    stage('Install dependencies') {
      steps { sh '<%= install %>' }
    }
<% end -%>
<% if lint -%>
    stage('Lint') {
      steps { sh '<%= "PATH=$PWD/.bin:$PATH " if just %><%= lint %>' }
    }
<% end -%>
<% if test -%>
    stage('Test') {
      steps { sh '<%= "PATH=$PWD/.bin:$PATH " if just %><%= test %>' }
    }
<% end -%>
  }
}
